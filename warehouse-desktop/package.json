{
  "name": "fastgo-warehouse-desktop",
  "version": "1.0.37",
  "private": true,
  "description": "FastGo standalone warehouse and terminal checkout station",
  "author": "FastGo",
  "main": "main.cjs",
  "scripts": {
    "build": "node prepare.cjs && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.10"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ru.fastgo.warehouse",
    "productName": "FastGo Склад",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "updates.cjs",
      "package.json",
      "terminal-update.cjs",
      "terminal-preload.cjs",
      "terminal.html",
      "terminal-ui.js",
      "warehouse-preload.cjs",
      "warehouse-bridge.cjs",
      "usb-scanner.cjs",
      "usb-bridge.cjs",
      "usb-preload.cjs",
      "usb-control.html",
      "usb-control.js",
      "usb-phone.html",
      "usb-phone.js",
      "update-clock.cjs",
      "auto-terminal.cjs",
      "terminal-provision.cjs",
      "bundled-ui.cjs",
      "web/**/*",
      "background.cjs",
      "window-controls.cjs",
      "barcode-print.cjs",
      "avito-toast.cjs",
      "avito-toast-preload.cjs",
      "backup-replica.cjs",
      "backup-scheduler.cjs",
      "network-diagnostics.cjs",
      "network-window.cjs",
      "network-preload.cjs",
      "network-snapshot.ps1",
      "network.html",
      "network.css",
      "network-ui.js",
      "printer-profiles.cjs",
      "receipt-label-journal.cjs",
      "scanner-diagnostics.cjs",
      "label-printer-setup.cjs",
      "label-printer-setup.ps1",
      "pc365-setup.cjs",
      "pc365-setup.ps1"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "FastGo-Warehouse-Setup-${version}-Windows-x64.exe",
      "signAndEditExecutable": false
    },
    "nsis": {
      "include": "installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "shortcutName": "FastGo Склад",
      "perMachine": false
    },
    "forceCodeSigning": false,
    "npmRebuild": false,
    "publish": {
      "provider": "generic",
      "url": "https://raw.githubusercontent.com/ivankirillov414-art/fastgo-control/main/warehouse/update/"
    },
    "extraResources": [
      {
        "from": "platform-tools",
        "to": "platform-tools"
      },
      {
        "from": "p2-driver",
        "to": "p2-driver"
      },
      {
        "from": "pc365-driver",
        "to": "pc365-driver"
      }
    ],
    "executableName": "FastGo РЎРєР»Р°Рґ"
  }
}
